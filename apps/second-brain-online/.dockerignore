# .dockerignore - Critical for preventing bloat

# Python runtime
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments (DON'T copy local venv!)
.venv/
.venv-online/
venv/
env/
ENV/
**/.venv/

# uv and pip caches (CRITICAL!)
.uv/
.uv_cache/
.cache/
**/.cache/
.pip/
**/.pip/

# Transformers/Huggingface caches (HUGE!)
.transformers_cache/
.huggingface/
**/.transformers_cache/
**/.huggingface/

# Model files (DO NOT COPY!)
*.bin
*.pt
*.pth
*.onnx
*.h5
*.safetensors
*.msgpack
*.ckpt
models/
**/models/

# Environment
.env
.env.*
!.env.example

# Testing
.pytest_cache/
.coverage
htmlcov/
tests/
**tests**/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Git
.git/
.github/

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Build
dist/
build/
*.egg-info/

# Logs
*.log
logs/

# Data
data/
*.csv
*.json
*.pkl

# Documentation
# README.md
docs/
# *.md
!pyproject.toml
!uv.lock

# Tools/scripts not needed in container
Makefile
commands.txt
.python-version